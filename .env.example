# Local application
NODE_ENV=development
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digibase?schema=public

# Authentication
AUTH_RESET_TOKEN_SECRET=replace-with-a-long-random-secret

# Seed account (required by npm run db:seed)
SEED_ROOT_LOGIN=root
SEED_ROOT_EMAIL=root@example.com
SEED_ROOT_PASSWORD=change-me
# Optional additional admin account
SEED_ADMIN_EMAIL=

# Email / SMTP (optional for local development)
SMTP_EMAIL_HOST=
SMTP_EMAIL_PORT=587
SMTP_EMAIL_USER=
SMTP_EMAIL_PASSWORD=
SMTP_EMAIL_FROM=

# S3-compatible media storage (optional; defaults are used when omitted)
S3_ENDPOINT=https://s3.cloud.cmctelecom.vn
S3_BUCKET=oneship
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Geocoding (optional)
ARCGIS_GEOCODE_CANDIDATES_URL=
ARCGIS_GEOCODE_SUGGEST_URL=
ARCGIS_GEOCODE_COUNTRY_CODE=VNM
ARCGIS_GEOCODE_LOCATION=

# Optional CDN / frontend build values
CDN_BASE_URL=
CMC_CDN_BASE_URL=
VITE_API_PREFIX=
